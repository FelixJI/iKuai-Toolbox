{
  // CLI targets / CLI 发布目标
  // Why/为什么: Go 交叉编译以 goos/goarch/goarm 描述目标；label 是资产命名与
  // docker/bin 目录的稳定键，资产名经 arch-helpers.sh 映射后与历史版本逐字节一致。
  // English: targets are described by goos/goarch/goarm for Go cross-compile;
  // label is the stable key for asset naming and docker/bin layout, mapped via
  // arch-helpers.sh to byte-identical legacy asset names.
  "cli": [
    {
      "label": "linux-amd64",
      "goos": "linux",
      "goarch": "amd64",
      "archive": "zip",
      "docker_platform": "linux/amd64",
      "mode": ["minimal", "full"]
    },
    {
      "label": "linux-386",
      "goos": "linux",
      "goarch": "386",
      "archive": "zip",
      "docker_platform": "linux/386",
      "mode": ["full"]
    },
    {
      "label": "linux-arm5",
      "goos": "linux",
      "goarch": "arm",
      "goarm": "5",
      "archive": "zip",
      "docker_platform": "",
      "mode": ["full"]
    },
    {
      "label": "linux-arm6",
      "goos": "linux",
      "goarch": "arm",
      "goarm": "6",
      "archive": "zip",
      "docker_platform": "",
      "mode": ["full"]
    },
    {
      "label": "linux-arm7",
      "goos": "linux",
      "goarch": "arm",
      "goarm": "7",
      "archive": "zip",
      "docker_platform": "linux/arm/v7",
      "mode": ["full"]
    },
    {
      "label": "linux-arm64",
      "goos": "linux",
      "goarch": "arm64",
      "archive": "zip",
      "docker_platform": "linux/arm64",
      "mode": ["full"]
    },
    {
      "label": "linux-ppc64le",
      "goos": "linux",
      "goarch": "ppc64le",
      "archive": "zip",
      "docker_platform": "linux/ppc64le",
      "mode": ["full"]
    },
    {
      "label": "linux-riscv64",
      "goos": "linux",
      "goarch": "riscv64",
      "archive": "zip",
      "docker_platform": "linux/riscv64",
      "mode": ["full"]
    },
    {
      "label": "windows-amd64",
      "goos": "windows",
      "goarch": "amd64",
      "archive": "zip",
      "docker_platform": "",
      "mode": ["minimal", "full"]
    },
    {
      "label": "macos-amd64",
      "goos": "darwin",
      "goarch": "amd64",
      "archive": "zip",
      "docker_platform": "",
      "mode": ["full"]
    },
    {
      "label": "macos-arm64",
      "goos": "darwin",
      "goarch": "arm64",
      "archive": "zip",
      "docker_platform": "",
      "mode": ["full"]
    }
  ],

  // BSD targets / BSD 发布目标
  // Why/为什么: Go 原生支持 freebsd 交叉编译，不再需要 FreeBSD VM。
  // English: Go supports freebsd cross-compile natively, no FreeBSD VM needed.
  "bsd": [
    {
      "label": "freebsd-amd64",
      "goos": "freebsd",
      "goarch": "amd64",
      "archive": "zip",
      "mode": ["full"]
    },
    {
      "label": "freebsd-386",
      "goos": "freebsd",
      "goarch": "386",
      "archive": "zip",
      "mode": ["full"]
    }
  ],

  // Experimental MIPS targets / 实验性 MIPS 目标
  // Why/为什么: Go 对 MIPS 是一等支持，不再需要 nightly 工具链；仍保留
  // nightly 实验语义（job continue-on-error，仅 full 模式自动包含）。
  // English: MIPS is first-class in Go, no nightly toolchain needed; the
  // experimental semantics stay (continue-on-error job, full mode only).
  "cli_nightly": [
    {
      "label": "linux-mipsel",
      "goos": "linux",
      "goarch": "mipsle",
      "archive": "zip",
      "mode": ["full"]
    },
    {
      "label": "linux-mips64",
      "goos": "linux",
      "goarch": "mips64",
      "archive": "zip",
      "mode": ["full"]
    },
    {
      "label": "linux-mips64el",
      "goos": "linux",
      "goarch": "mips64le",
      "archive": "zip",
      "mode": ["full"]
    },
    {
      "label": "linux-mips",
      "goos": "linux",
      "goarch": "mips",
      "archive": "zip",
      "mode": ["full"]
    }
  ],

  // Desktop GUI targets / 桌面 GUI 发布目标
  // Why/为什么: Tauri 壳仍是 Rust 构建（target 为 Rust 三元组）；构建前先用
  // goos/goarch 交叉编译 sidecar 到 apps/gui/binaries/ikuai-bypass-go-<target>。
  // English: the Tauri shell is still Rust-built (target is the Rust triple);
  // the Go sidecar is cross-compiled first into apps/gui/binaries/ikuai-bypass-go-<target>.
  "gui": [
    {
      "label": "linux-x86_64",
      "runner": "ubuntu-22.04",
      "target": "x86_64-unknown-linux-gnu",
      "goos": "linux",
      "goarch": "amd64",
      "bundle_args": "",
      "bundle_active": false,
      "collect_pattern": "target/release/ikb-app",
      "mode": ["minimal", "full"]
    },
    {
      "label": "windows-x86_64",
      "runner": "windows-latest",
      "target": "x86_64-pc-windows-msvc",
      "goos": "windows",
      "goarch": "amd64",
      "bundle_args": "",
      "bundle_active": false,
      // Why/为什么: 显式点名 ikb-app.exe；通配 *.exe 会把 tauri-build 复制进来的
      // sidecar ikuai-bypass-go.exe 也收进 GUI zip（后写覆盖导致 zip 内容错乱）。
      // English: pin ikb-app.exe explicitly; a *.exe wildcard would also pick up
      // the sidecar ikuai-bypass-go.exe copied by tauri-build and overwrite the zip.
      "collect_pattern": "target/release/ikb-app.exe",
      "mode": ["full"]
    },
    {
      "label": "macos-aarch64",
      "runner": "macos-15",
      "target": "aarch64-apple-darwin",
      "goos": "darwin",
      "goarch": "arm64",
      "bundle_args": "--bundles dmg",
      "bundle_active": true,
      "collect_pattern": "target/release/bundle/**/*.dmg",
      "mode": ["full"]
    },
    {
      "label": "macos-x86_64",
      "runner": "macos-15",
      "target": "x86_64-apple-darwin",
      "goos": "darwin",
      "goarch": "amd64",
      "bundle_args": "--bundles dmg",
      "bundle_active": true,
      "collect_pattern": "target/release/bundle/**/*.dmg",
      "mode": ["full"]
    }
  ],

  // Android GUI targets / Android GUI 发布目标
  // Why/为什么: 移动壳不启动 sidecar，构建配置剔除 externalBin（无 goos/goarch）。
  // English: the mobile shell never spawns the sidecar; externalBin is stripped
  // from the generated config (no goos/goarch needed).
  "gui_android": [
    {
      "label": "android-aarch64",
      "runner": "ubuntu-latest",
      "target": "aarch64-linux-android",
      "tauri_target": "aarch64",
      "mode": ["full"]
    },
    {
      "label": "android-armv7",
      "runner": "ubuntu-latest",
      "target": "armv7-linux-androideabi",
      "tauri_target": "armv7",
      "mode": ["full"]
    },
    {
      "label": "android-x86_64",
      "runner": "ubuntu-latest",
      "target": "x86_64-linux-android",
      "tauri_target": "x86_64",
      "mode": ["full"]
    }
  ],

  // iOS GUI targets / iOS GUI 发布目标（同 Android，不打包 sidecar）
  "gui_ios": [
    {
      "label": "ios-aarch64",
      "runner": "macos-15",
      "target": "aarch64-apple-ios",
      "tauri_target": "aarch64",
      "mode": ["full"]
    }
  ]
}
